{
  "name": "loadforge",
  "version": "1.0.0",
  "description": "A lightweight HTTP load testing tool built with Node.js and TypeScript",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "load-testing",
    "http",
    "performance",
    "benchmark",
    "nodejs",
    "typescript"
  ],
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@rolldown/binding-win32-x64-msvc": "^1.2.16",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "zod": "^4.6.7"
  },
  "bin": {
    "loadforge": "./dist/index.js"
  }
}